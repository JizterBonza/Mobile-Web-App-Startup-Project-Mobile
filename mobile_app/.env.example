# Environment Variables
MOBILE_LOCAL_URL=http://10.0.2.2:8000
WEB_LOCAL_URL=http://127.0.0.1:8000
IP_ADDRESS=http://192.168.254.106:8000
Google_URL=http://127.0.0.1:8000
QA_URL=https://portal.agrify-connect.com
STAGING_URL=https://staging-klasmeyt.agrify-connect.com
GOOGLE_MAPS_API_KEY=
# Web OAuth client (Laravel GOOGLE_CLIENT_ID) — required for Google Sign-In id_token
