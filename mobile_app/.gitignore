# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
._*
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Keep local tests ignored except the customer Farms regression tests.
!/test/
/test/*
!/test/customer_nav_farms_test.dart
!/test/partner_farms_screen_test.dart

# Search suggestion regression tests.
!/test/farm_store_search_test.dart
!/test/search_suggestions_test.dart
!/test/items_provider_search_test.dart
!/test/marketplace_search_test.dart
!/test/price_format_test.dart
!/test/catalog_search_test.dart
!/test/search_product_details_test.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
